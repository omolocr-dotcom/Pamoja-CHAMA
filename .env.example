# Never commit real secrets. Set these in Chajio's environment/secrets panel.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Use a long random secret (at least 32 bytes); never reuse SMTP password.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
OTP_PEPPER=replace-with-another-random-secret-at-least-32-characters-long
SMTP_HOST=cloud2310.liveboxserver.uk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=login@wavehub.co.ke
SMTP_PASS=SET_IN_CHAJIO_SECRET_PANEL
EMAIL_FROM=login@wavehub.co.ke
# Comma-separated exact email addresses allowed developer access.
DEV_ADMIN_EMAILS=your-authorized-address@example.com
# Frontend API origin for a separately hosted API; omit for same-origin deployment.
CORS_ORIGIN=https://pamoja-f0a5ug.live.chajio.top
